#!/usr/bin/env python3
"""bim — ajoute et consulte les tâches du backlog Bim depuis un terminal ou une session Claude.

  bim add "Titre" [-p 1|2|3] [-d Domaine] [--due AAAA-MM-JJ] [--days 1,3,5] [--note …] [--source …]
  bim list
  bim done <début du titre ou de l'identifiant>

Le backlog est le fichier backlog.json du dépôt GitHub privé <compte>/bim-data
(ou celui de la variable BIM_REPO). L'accès passe par `gh`, déjà connecté.
"""
import argparse
import base64
import datetime
import json
import os
import random
import string
import subprocess
import sys
import time

DOMAINS = ["Travail", "Contenu", "Destiny", "Projets", "Sport", "Famille", "Perso"]
PRIO = {0: "échéance", 1: "urgent", 2: "important", 3: "quand je peux"}


def gh(*args, body=None):
    r = subprocess.run(["gh", "api", *args], input=body, capture_output=True, text=True)
    return r.returncode, r.stdout, r.stderr


def repo():
    if os.environ.get("BIM_REPO"):
        return os.environ["BIM_REPO"]
    code, out, err = gh("user", "-q", ".login")
    if code:
        sys.exit(f"gh n'est pas connecté : {err.strip()}")
    return f"{out.strip()}/bim-data"


def load(path):
    code, out, err = gh(path)
    if code:
        if "404" in err or "Not Found" in out:
            return {"version": 1, "tasks": [], "schedule": {}}, None
        sys.exit(f"Lecture impossible : {err.strip() or out.strip()}")
    j = json.loads(out)
    return json.loads(base64.b64decode(j["content"]).decode("utf-8")), j["sha"]


def change(fn, message):
    """Lit le backlog, applique fn, réécrit ; recommence si quelqu'un a écrit entre-temps."""
    path = f"repos/{repo()}/contents/backlog.json"
    for _ in range(4):
        doc, sha = load(path)
        result = fn(doc)
        body = {
            "message": message,
            "content": base64.b64encode(
                json.dumps(doc, ensure_ascii=False, indent=1).encode("utf-8")
            ).decode(),
        }
        if sha:
            body["sha"] = sha
        code, out, err = gh("-X", "PUT", path, "--input", "-", body=json.dumps(body))
        if code == 0:
            return result
        if "409" not in err and "422" not in err:
            sys.exit(f"Écriture impossible : {err.strip() or out.strip()}")
        time.sleep(1)
    sys.exit("Conflit de synchro répété, réessaie.")


def now_ms():
    return int(time.time() * 1000)


def is_open(t):
    return not t.get("deleted") and (t.get("days") or t.get("status") == "todo")


def eff(t):
    due = t.get("due")
    if due and not t.get("days") and due <= datetime.date.today().isoformat():
        return 0
    return t.get("priority", 2)


def cmd_add(a):
    if a.domain not in DOMAINS:
        sys.exit(f"Domaine inconnu. Choix : {', '.join(DOMAINS)}")
    if a.due:
        datetime.date.fromisoformat(a.due)
    days = sorted({int(d) for d in a.days.split(",")}) if a.days else []
    if any(d < 1 or d > 7 for d in days):
        sys.exit("--days attend des jours de 1 (lundi) à 7 (dimanche)")

    def fn(doc):
        tasks = doc.setdefault("tasks", [])
        for t in tasks:
            if is_open(t) and t["title"].strip().lower() == a.title.strip().lower():
                return None
        t = {
            "id": "".join(random.choices(string.ascii_lowercase + string.digits, k=8)),
            "title": a.title.strip(),
            "note": a.note,
            "domain": a.domain,
            "priority": a.priority,
            "due": a.due,
            "days": days,
            "source": a.source,
            "rank": max([x.get("rank", 0) for x in tasks] + [0]) + 1,
            "status": "todo",
            "createdAt": now_ms(),
            "updatedAt": now_ms(),
            "doneAt": None,
            "snoozeUntil": None,
            "startedAt": None,
            "deleted": False,
        }
        tasks.append(t)
        return t

    t = change(fn, f"bim : + {a.title.strip()[:60]}")
    print(f"Ajoutée ({PRIO[a.priority]}, {a.domain}) : {a.title}" if t
          else f"Déjà dans le backlog : {a.title}")


def cmd_list(_):
    doc, _sha = load(f"repos/{repo()}/contents/backlog.json")
    tasks = sorted((t for t in doc.get("tasks", []) if is_open(t)),
                   key=lambda t: (eff(t), t.get("rank", 0)))
    if not tasks:
        print("Backlog vide.")
    for t in tasks:
        extra = " · ".join(x for x in [
            t.get("domain", ""),
            f"échéance {t['due']}" if t.get("due") else "",
            "rituel" if t.get("days") else "",
            f"via {t['source']}" if t.get("source") else "",
        ] if x)
        print(f"{t['id']}  [{PRIO[eff(t)]}] {t['title']}  ({extra})")


def cmd_done(a):
    key = a.key.strip().lower()

    def fn(doc):
        hits = [t for t in doc.get("tasks", []) if is_open(t)
                and (t["id"].startswith(key) or t["title"].lower().startswith(key))]
        if len(hits) != 1:
            return hits
        t = hits[0]
        t["doneAt"] = t["updatedAt"] = now_ms()
        t["startedAt"] = t["snoozeUntil"] = None
        if not t.get("days"):
            t["status"] = "done"
        return hits

    hits = change(fn, f"bim : fait {a.key[:60]}")
    if len(hits) == 1:
        print(f"Terminée : {hits[0]['title']}")
    else:
        sys.exit("Aucune tâche trouvée." if not hits
                 else "Plusieurs tâches correspondent :\n" + "\n".join(f"  {t['id']}  {t['title']}" for t in hits))


def main():
    p = argparse.ArgumentParser(prog="bim", description="Backlog Bim")
    sub = p.add_subparsers(dest="cmd", required=True)
    a = sub.add_parser("add", help="ajouter une tâche")
    a.add_argument("title")
    a.add_argument("-p", "--priority", type=int, choices=[1, 2, 3], default=2)
    a.add_argument("-d", "--domain", default="Perso")
    a.add_argument("--due")
    a.add_argument("--days")
    a.add_argument("--note", default="")
    a.add_argument("--source", default="")
    a.set_defaults(fn=cmd_add)
    sub.add_parser("list", help="voir le backlog").set_defaults(fn=cmd_list)
    d = sub.add_parser("done", help="terminer une tâche")
    d.add_argument("key")
    d.set_defaults(fn=cmd_done)
    args = p.parse_args()
    args.fn(args)


if __name__ == "__main__":
    main()
