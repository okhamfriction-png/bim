#!/usr/bin/env python3
"""bim — ajoute et consulte les tâches du backlog Bim depuis un terminal ou une session Claude.

  bim add "Titre" [-d Mission|Contenu|Destiny|Personnel|Parking] [-p 0|1|2|3|4] [--call] [--source …]
          [--note "descriptif" | --note-file script.md] [--link URL]… [--file video.mp4]…
  bim rm <début du titre ou de l'identifiant>
  bim list
  bim done <début du titre ou de l'identifiant>
  bim courses [article…]        sans article : voir la liste ; avec : les ajouter
  bim courses --pris <article>  cocher un article

Le backlog est le fichier backlog.json du dépôt GitHub privé <compte>/bim-data
(ou celui de la variable BIM_REPO). L'accès passe par `gh`, déjà connecté ; sur une machine
sans `gh` (le serveur MCP du NAS), il passe par le jeton de la variable BIM_TOKEN.

Ce fichier est aussi le seul chemin d'écriture du serveur MCP (dossier mcp/) : il l'importe
et passe par `change`, comme la ligne de commande.
"""
import argparse
import base64
import datetime
import json
import os
import random
import re
import string
import subprocess
import sys
import time
import urllib.error
import urllib.request

DOMAINS = ["Mission", "Contenu", "Destiny", "Personnel", "Parking"]
PRIO = {i: f"P{i}" for i in range(5)}


class BimError(Exception):
    """Lecture ou écriture impossible. La ligne de commande s'arrête, le serveur MCP répond une erreur."""


def _api(args, body):
    """Même contrat que `gh api`, avec le jeton BIM_TOKEN : (code, sortie, erreur)."""
    method, path = "GET", None
    it = iter(args)
    for a in it:
        if a == "-X":
            method = next(it)
        elif a == "--input":
            next(it)
        elif a == "-q":
            next(it)
        else:
            path = a
    req = urllib.request.Request(
        f"{os.environ.get('GITHUB_API', 'https://api.github.com')}/{path}",
        data=body.encode("utf-8") if body else None, method=method,
        headers={"Authorization": f"Bearer {os.environ['BIM_TOKEN']}",
                 "Accept": "application/vnd.github+json", "X-GitHub-Api-Version": "2022-11-28",
                 "User-Agent": "bim", "Content-Type": "application/json"})
    try:
        with urllib.request.urlopen(req, timeout=30) as r:
            return 0, r.read().decode("utf-8"), ""
    except urllib.error.HTTPError as e:
        return 1, e.read().decode("utf-8", "replace"), f"HTTP {e.code}"
    except OSError as e:
        return 1, "", f"réseau : {e}"


def gh(*args, body=None):
    if os.environ.get("BIM_TOKEN"):
        return _api(args, body)
    r = subprocess.run(["gh", "api", *args], input=body, capture_output=True, text=True)
    return r.returncode, r.stdout, r.stderr


def repo():
    if os.environ.get("BIM_REPO"):
        return os.environ["BIM_REPO"]
    code, out, err = gh("user", "-q", ".login")
    if code:
        raise BimError(f"gh n'est pas connecté : {err.strip()}")
    return f"{out.strip()}/bim-data"


EMPTY = {
    "backlog.json": lambda: {"version": 1, "tasks": [], "schedule": {}},
    "consignes.json": lambda: {"v": 1, "consignes": []},
    "courses.json": lambda: {"v": 1, "items": []},
}


def load(path):
    code, out, err = gh(path)
    if code:
        if "404" in err or "Not Found" in out:
            return EMPTY[path.rsplit("/", 1)[-1]](), None
        raise BimError(f"Lecture impossible : {err.strip() or out.strip()[:300]}")
    j = json.loads(out)
    return json.loads(base64.b64decode(j["content"]).decode("utf-8")), j["sha"]


def read(name="backlog.json"):
    """Le contenu d'un fichier du dépôt de données, sans rien écrire."""
    return load(f"repos/{repo()}/contents/{name}")[0]


def change(fn, message, name="backlog.json"):
    """Lit le fichier, applique fn, réécrit ; recommence si quelqu'un a écrit entre-temps.

    Seul chemin d'écriture vers le dépôt de données, pour la ligne de commande comme pour
    le serveur MCP. Si fn lève une exception, rien n'est écrit.
    """
    path = f"repos/{repo()}/contents/{name}"
    for _ in range(4):
        doc, sha = load(path)
        before = json.dumps(doc, ensure_ascii=False, sort_keys=True)
        result = fn(doc)
        if json.dumps(doc, ensure_ascii=False, sort_keys=True) == before:
            return result
        body = {
            "message": message,
            "content": base64.b64encode(
                json.dumps(doc, ensure_ascii=False, indent=1).encode("utf-8")
            ).decode(),
        }
        if sha:
            body["sha"] = sha
        code, out, err = gh("-X", "PUT", path, "--input", "-", body=json.dumps(body))
        if code == 0:
            return result
        if "409" not in err and "422" not in err:
            raise BimError(f"Écriture impossible : {err.strip() or out.strip()[:300]}")
        time.sleep(1)
    raise BimError("Conflit de synchro répété, réessaie.")


def upload(path, tid):
    """Envoie une vidéo ou une image dans media/ du dépôt de données ; renvoie son chemin."""
    size = os.path.getsize(path)
    if size > 95 * 1024 * 1024:
        sys.exit(f"{path} fait {size // 1048576} Mo : GitHub refuse au-delà de 100 Mo. Compresse-la d'abord.")
    name = re.sub(r"[^A-Za-z0-9._-]+", "-", os.path.basename(path)).strip("-")
    dest = f"media/{tid}-{name}"
    with open(path, "rb") as f:
        body = json.dumps({"message": f"bim : fichier {name}",
                           "content": base64.b64encode(f.read()).decode()})
    code, out, err = gh("-X", "PUT", f"repos/{repo()}/contents/{dest}", "--input", "-", body=body)
    if code:
        sys.exit(f"Envoi de {path} impossible : {err.strip() or out.strip()[:300]}")
    return dest


def now_ms():
    return int(time.time() * 1000)


def is_open(t):
    return not t.get("deleted") and t.get("status") == "todo"


def cat(t):
    d = t.get("domain", "Personnel")
    return d if d in DOMAINS else ("Mission" if d == "Travail" else "Personnel")


def order(t):
    return (t.get("priority", 2), DOMAINS.index(cat(t)), t.get("rank", 0))


def new_id():
    return "".join(random.choices(string.ascii_lowercase + string.digits, k=8))


def new_task(doc, title, domain="Personnel", priority=2, note="", links=None, source="",
             call=False, sprint=None, tid=None):
    """Ajoute une tâche au document ; None si une tâche ouverte porte déjà ce titre."""
    tasks = doc.setdefault("tasks", [])
    title = title.strip()
    for t in tasks:
        if is_open(t) and t["title"].strip().lower() == title.lower():
            return None
    t = {
        "id": tid or new_id(),
        "title": title,
        "note": note,
        "links": list(links or []),
        "domain": domain,
        "priority": priority,
        "source": source,
        "rank": max([x.get("rank", 0) for x in tasks] + [0]) + 1,
        "status": "todo",
        "createdAt": now_ms(),
        "updatedAt": now_ms(),
        "doneAt": None,
        "pickedOn": None,
        "call": bool(call) and domain == "Mission",
        "sprint": sprint,
        "deleted": False,
    }
    tasks.append(t)
    return t


def cmd_add(a):
    if a.domain not in DOMAINS:
        sys.exit(f"Domaine inconnu. Choix : {', '.join(DOMAINS)}")
    note = a.note
    if a.note_file:
        with open(a.note_file, encoding="utf-8") as f:
            note = (note + "\n\n" if note else "") + f.read().strip()

    tid = new_id()
    links = list(a.link or [])
    for path in a.file or []:
        links.append(upload(path, tid))

    def fn(doc):
        return new_task(doc, a.title, a.domain, a.priority, note=note, links=links,
                        source=a.source, call=a.call, tid=tid)

    t = change(fn, f"bim : + {a.title.strip()[:60]}")
    print(f"Ajoutée ({a.domain}, {PRIO[a.priority]}) : {a.title}" if t
          else f"Déjà dans le backlog : {a.title}")


def cmd_list(_):
    doc, _sha = load(f"repos/{repo()}/contents/backlog.json")
    tasks = sorted((t for t in doc.get("tasks", []) if is_open(t)), key=order)
    if not tasks:
        print("Backlog vide.")
    today = datetime.date.today().isoformat()
    for t in tasks:
        extra = " · ".join(x for x in [
            PRIO[t.get('priority', 2)],
            "appel ou entretien" if t.get("call") else "",
            "choisie aujourd'hui" if t.get("pickedOn") == today else "",
            f"via {t['source']}" if t.get("source") else "",
        ] if x)
        print(f"{t['id']}  [{cat(t)}] {t['title']}  ({extra})")


def cmd_done(a):
    key = a.key.strip().lower()

    def fn(doc):
        hits = [t for t in doc.get("tasks", []) if is_open(t)
                and (t["id"].startswith(key) or t["title"].lower().startswith(key))]
        if len(hits) != 1:
            return hits
        t = hits[0]
        t["doneAt"] = t["updatedAt"] = now_ms()
        t["status"] = "done"
        return hits

    hits = change(fn, f"bim : fait {a.key[:60]}")
    if len(hits) == 1:
        print(f"Terminée : {hits[0]['title']}")
    else:
        sys.exit("Aucune tâche trouvée." if not hits
                 else "Plusieurs tâches correspondent :\n" + "\n".join(f"  {t['id']}  {t['title']}" for t in hits))


def cmd_rm(a):
    key = a.key.strip().lower()

    def fn(doc):
        hits = [t for t in doc.get("tasks", []) if not t.get("deleted")
                and (t["id"].startswith(key) or t["title"].lower().startswith(key))]
        if len(hits) == 1:
            hits[0]["deleted"] = True
            hits[0]["updatedAt"] = now_ms()
        return hits

    hits = change(fn, f"bim : - {a.key[:60]}")
    if len(hits) == 1:
        print(f"Supprimée : {hits[0]['title']}")
    else:
        sys.exit("Aucune tâche trouvée." if not hits
                 else "Plusieurs tâches correspondent :\n" + "\n".join(f"  {t['id']}  {t['title']}" for t in hits))


def courses_add(doc, names):
    """Ajoute des articles à la liste de courses ; renvoie (ajoutés, déjà présents)."""
    items = doc.setdefault("items", [])
    added, known = [], []
    for name in names:
        name = name.strip()
        if not name:
            continue
        same = [i for i in items if not i.get("deleted") and i["text"].strip().lower() == name.lower()]
        if same and not all(i.get("done") for i in same):
            known.append(name)
            continue
        if same:  # déjà pris la dernière fois : on le remet à acheter
            same[0]["done"] = False
            same[0]["updatedAt"] = now_ms()
        else:
            items.append({"id": new_id(), "text": name[:1].upper() + name[1:], "done": False,
                          "updatedAt": now_ms()})
        added.append(name)
    return added, known


def cmd_courses(a):
    if a.pris:
        key = a.pris.strip().lower()

        def fn(doc):
            hits = [i for i in doc.get("items", []) if not i.get("deleted") and not i.get("done")
                    and i["text"].lower().startswith(key)]
            if len(hits) == 1:
                hits[0]["done"] = True
                hits[0]["updatedAt"] = now_ms()
            return hits

        hits = change(fn, "bim : courses", "courses.json")
        if len(hits) != 1:
            sys.exit("Aucun article trouvé." if not hits else "Plusieurs articles correspondent : "
                     + ", ".join(i["text"] for i in hits))
        print(f"Pris : {hits[0]['text']}")
    if a.articles:
        added, known = change(lambda doc: courses_add(doc, a.articles), "bim : courses", "courses.json")
        if added:
            print("Ajouté aux courses : " + ", ".join(added))
        if known:
            print("Déjà dans la liste : " + ", ".join(known))
    if not a.pris and not a.articles:
        items = [i for i in read("courses.json").get("items", []) if not i.get("deleted")]
        if not items:
            print("Liste de courses vide.")
        for i in sorted(items, key=lambda i: bool(i.get("done"))):
            print(("[x] " if i.get("done") else "[ ] ") + i["text"])


def cmd_rappel(a):
    """Rappels de l'agenda : un repère à l'heure dite, pas un créneau."""
    def alive(doc):
        return [e for e in doc.get("schedule", {}).get("events", [])
                if e.get("rappel") and not e.get("deleted") and not e.get("sante")]

    if a.fait:
        key = a.fait.strip().lower()

        def fn(doc):
            hits = [e for e in alive(doc) if not e.get("done") and e["label"].lower().startswith(key)]
            if len(hits) == 1:
                hits[0]["done"] = True
                hits[0]["at"] = now_ms()
                doc["schedule"]["updatedAt"] = now_ms()
            return hits

        hits = change(fn, "bim : rappel fait")
        if len(hits) != 1:
            sys.exit("Aucun rappel trouvé." if not hits else "Plusieurs rappels correspondent : "
                     + ", ".join(e["label"] for e in hits))
        print(f"Fait : {hits[0]['label']}")
        return
    if a.texte:
        try:
            day = time.strftime("%Y-%m-%d", time.strptime(a.jour, "%Y-%m-%d")) if a.jour \
                else time.strftime("%Y-%m-%d")
            h, _, m = (a.heure or "9").lower().replace("h", ":").partition(":")
            start = int(h) * 60 + int(m or 0)
            if not 0 <= start < 1440:
                raise ValueError
        except ValueError:
            sys.exit("Jour au format 2026-11-29, heure au format 11:00 ou 11h30.")
        label = a.texte.strip()

        def fn(doc):
            sc = doc.setdefault("schedule", {})
            if any(e["label"].lower() == label.lower() and e.get("date") == day and e.get("start") == start
                   for e in alive(doc)):
                return False
            sc.setdefault("events", []).append({
                "id": new_id(), "date": day, "start": start, "label": label, "blockId": None,
                "cutEnd": None, "rappel": True, "done": False, "at": now_ms()})
            sc["updatedAt"] = now_ms()
            return True

        ok = change(fn, "bim : rappel")
        print((f"Rappel ajouté : {label}" if ok else f"Déjà dans l'agenda : {label}")
              + f" ({day} à {start // 60} h{start % 60:02d})")
        return
    items = sorted(alive(read()), key=lambda e: (e.get("date", ""), e.get("start", 0)))
    if not items:
        print("Aucun rappel.")
    for e in items:
        print(("[x] " if e.get("done") else "[ ] ")
              + f"{e['date']} {e['start'] // 60:02d}:{e['start'] % 60:02d}  {e['label']}")


def main():
    p = argparse.ArgumentParser(prog="bim", description="Backlog Bim")
    sub = p.add_subparsers(dest="cmd", required=True)
    a = sub.add_parser("add", help="ajouter une tâche")
    a.add_argument("title")
    a.add_argument("-p", "--priority", type=int, choices=[0, 1, 2, 3, 4], default=2,
                   help="P0 (le plus urgent) à P4")
    a.add_argument("-d", "--domain", default="Personnel",
                   help="catégorie : " + ", ".join(DOMAINS))
    a.add_argument("--call", action="store_true",
                   help="appel ou entretien de mission : passe devant tout (catégorie Mission)")
    a.add_argument("--note", default="", help="descriptif affiché quand on déplie la tâche")
    a.add_argument("--note-file", help="fichier texte à mettre en descriptif (script, plan…)")
    a.add_argument("--link", action="append", help="lien, vidéo (.mp4) ou image ; répétable")
    a.add_argument("--file", "--video", action="append",
                   help="vidéo ou image du Mac à envoyer avec la tâche (95 Mo max) ; répétable")
    a.add_argument("--source", default="")
    a.set_defaults(fn=cmd_add)
    sub.add_parser("list", help="voir le backlog").set_defaults(fn=cmd_list)
    d = sub.add_parser("done", help="terminer une tâche")
    d.add_argument("key")
    d.set_defaults(fn=cmd_done)
    r = sub.add_parser("rm", help="supprimer une tâche")
    r.add_argument("key")
    r.set_defaults(fn=cmd_rm)
    c = sub.add_parser("courses", help="liste de courses : voir, ajouter, cocher")
    c.add_argument("articles", nargs="*")
    c.add_argument("--pris", help="cocher l'article qui commence ainsi")
    c.set_defaults(fn=cmd_courses)
    ra = sub.add_parser("rappel", help="rappels de l'agenda : voir, ajouter, cocher")
    ra.add_argument("texte", nargs="?")
    ra.add_argument("-j", "--jour", help="jour, au format 2026-11-29 (aujourd'hui par défaut)")
    ra.add_argument("-H", "--heure", help="heure, 11:00 ou 11h30 (9 h par défaut)")
    ra.add_argument("--fait", help="cocher le rappel qui commence ainsi")
    ra.set_defaults(fn=cmd_rappel)
    args = p.parse_args()
    try:
        args.fn(args)
    except BimError as e:
        sys.exit(str(e))


if __name__ == "__main__":
    main()
